{
  "compilerOptions": {
    /* Base Options */
    "target": "ESNext", // Target modern JavaScript
    "module": "ESNext", // Use modern module system
    "lib": ["ESNext", "DOM", "DOM.Iterable"], // Include necessary libraries
    "skipLibCheck": true, // Skip type checking of declaration files

    /* Bundler & Module Resolution */
    "moduleResolution": "bundler", // Align with Vite/modern bundlers
    "allowImportingTsExtensions": true, // Allow '.ts' imports (needed for bundler resolution)
    "resolveJsonModule": true, // Allow importing JSON files
    "isolatedModules": true, // Ensure files can be transpiled independently
    "moduleDetection": "force", // Treat files as modules

    /* Emit */
    "declaration": true, // Generate .d.ts files
    "emitDeclarationOnly": true, // Only emit .d.ts files (JS is handled by Vite)
    "outDir": "dist", // Specify output directory for .d.ts files
    "declarationMap": true, // Generate sourcemaps for .d.ts files

    /* Linting & Strictness */
    "strict": true, // Enable all strict type-checking options
    "noUnusedLocals": true, // Report errors on unused local variables
    "noUnusedParameters": true, // Report errors on unused parameters
    "noFallthroughCasesInSwitch": true, // Report errors for fallthrough cases in switch statements
    "noImplicitAny": true, // Raise error on expressions and declarations with an implied 'any' type
    "useDefineForClassFields": true, // Use standard class fields definition emit

    /* Vue Specific */
    "jsx": "preserve", // Preserve JSX for Vue to handle

    /* Paths */
    "baseUrl": ".", // Base directory for non-relative module names
    "paths": {
      "@/*": ["src/*"] // Alias for src directory
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"], // Files included in the compilation
  "exclude": ["node_modules", "dist", "example"], // Exclude build output, deps, and example app (if any)
  "references": [
    { "path": "./tsconfig.node.json" } // Reference the config for Node-specific files
  ]
}
